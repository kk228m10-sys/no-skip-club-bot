# Скопируй этот файл в .env и заполни значения.
# На Bothost эти же ключи задай в панели: Variables / Env (НЕ заливай .env в zip/git).
# ------------------------------------------------------

# Токен бота от @BotFather
BOT_TOKEN=

# Твой личный Telegram chat_id (число). Узнать: @userinfobot
ADMIN_CHAT_ID=

# HTTPS-адрес мини-аппа (если не используешь — оставь пустым)
WEBAPP_URL=
WEBAPP_PORT=5000

# Мини-апп с персонажем: true/false
CHARACTER_ENABLED=false

# Час утреннего напоминания (0-23) в твоём часовом поясе
REMINDER_HOUR=8

# Часовой пояс (важно на хостинге! иначе дедлайны уедут в UTC)
# Казахстан: Asia/Almaty  |  Россия: Europe/Moscow
TZ=Asia/Almaty

# Путь к SQLite. Локально можно не трогать.
# На Bothost с Volume: /data/no_skip.db
# DB_PATH=/data/no_skip.db

PENALTY_AMOUNT_RUB=500
PENALTY_AMOUNT_KZT=3000
COACH_USERNAME=jimon_000

# Ключ Mistral AI (console.mistral.ai) — психолог + проверка фото
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_VISION_MODEL=pixtral-12b-2409
